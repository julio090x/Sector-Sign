{
  "name": "sector-sign-angular-unificado",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "start:centro": "ng serve centro --proxy-config proxy.conf.json --port 4200",
    "start:receptor": "ng serve receptor --proxy-config proxy.conf.json --port 4201",
    "build:centro": "ng build centro --configuration production --base-href=/angular/centro/",
    "build:receptor": "ng build receptor --configuration production --base-href=/angular/receptor/",
    "build": "npm run build:centro && npm run build:receptor",
    "check:tipos": "tsc -p tsconfig.compartido.json --noEmit"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "typescript": "~5.9.3"
  }
}
